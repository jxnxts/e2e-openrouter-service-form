{
  "name": "e2e-community-mandu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/run.mjs deterministic",
    "test:contract": "node --test tests/contract/*.test.ts",
    "test:agent-contract": "node scripts/run.mjs contract",
    "test:offline": "npm run build && npm run test:contract && npm run test:security && npm test && npm run test:agent-contract",
    "test:mandu": "node scripts/run.mjs mandu",
    "test:security": "node --test tests/security/*.test.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.92",
    "@e2e-dev/web": "0.16.0",
    "@types/node": "26.6.6",
    "ai": "7.0.173",
    "e2e": "0.23.1",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
